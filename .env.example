# Copy to .env.local for local development. NAMES ONLY — never commit a value.
# Local `.env*` files are gitignored except this one.
#
# Two separate Anthropic keys. Do NOT reuse one across both:
#   - local development  -> your .env.local, never set on Vercel
#   - protected demo     -> Vercel, Preview target, `claude-demo` branch only
# A key scoped to one environment can be rotated without disturbing the other,
# and a leak from either is contained. See "Deployment runbook" in README.md.

# --- server only (never prefixed VITE_, never reaches the browser) -----------

# Anthropic API key for the Claude engine.
ANTHROPIC_API_KEY=

# Model the endpoint calls. Unset falls back to the in-code default.
ANTHROPIC_MODEL=

# Server-side kill switch. ONLY the exact string "true" enables Claude —
# missing, empty, or anything else means disabled. The default must be safe.
CLAUDE_ENABLED=

# Salt for the per-caller log hash. Unset omits the field entirely rather than
# logging a bare address digest, which would be reversible.
LOG_SALT=

# --- build time (inlined into the client bundle — never put a secret here) ---

# Which engine the UI uses: "claude", or anything else for the heuristic engine.
# This is an engine NAME, not a secret.
VITE_ANALYSIS_ENGINE=
